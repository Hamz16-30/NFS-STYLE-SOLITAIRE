{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "1. Launch Solitaire GUI (Midnight Run)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--gui"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "2. Launch Solitaire Console (CLI)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--cli"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "3. Run Automated Tests (TC-01 to TC-22)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--test"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
